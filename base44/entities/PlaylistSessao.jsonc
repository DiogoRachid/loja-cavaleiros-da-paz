{
  "name": "PlaylistSessao",
  "type": "object",
  "properties": {
    "sessao_id": {
      "type": "string",
      "description": "ID da sess\u00e3o"
    },
    "sessao_data": {
      "type": "string",
      "description": "Data da sess\u00e3o"
    },
    "sessao_tipo": {
      "type": "string",
      "description": "Tipo da sess\u00e3o"
    },
    "spotify_playlist_id": {
      "type": "string",
      "description": "ID da playlist no Spotify"
    },
    "spotify_playlist_name": {
      "type": "string",
      "description": "Nome da playlist"
    },
    "spotify_playlist_image": {
      "type": "string",
      "description": "URL da imagem da playlist"
    },
    "spotify_playlist_uri": {
      "type": "string",
      "description": "URI da playlist no Spotify"
    },
    "tracks_selecionadas": {
      "type": "string",
      "description": "JSON com IDs das tracks selecionadas (vazio = todas)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de reprodu\u00e7\u00e3o na sess\u00e3o"
    },
    "notas": {
      "type": "string",
      "description": "Notas do Mestre de Harmonia"
    }
  },
  "required": [
    "sessao_id",
    "spotify_playlist_id",
    "spotify_playlist_name"
  ]
}