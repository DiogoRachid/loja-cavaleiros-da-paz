{
  "name": "Avaliacao",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "ID do item f\u00edsico (opcional)"
    },
    "documento_id": {
      "type": "string",
      "description": "ID do documento digital (opcional)"
    },
    "irmao_id": {
      "type": "string",
      "description": "ID do irm\u00e3o que avaliou"
    },
    "irmao_nome": {
      "type": "string",
      "description": "Nome do irm\u00e3o"
    },
    "nota": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Nota de 1 a 5"
    },
    "comentario": {
      "type": "string",
      "description": "Coment\u00e1rio sobre a obra"
    },
    "data_avaliacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da avalia\u00e7\u00e3o"
    }
  },
  "required": [
    "irmao_id",
    "nota",
    "data_avaliacao"
  ]
}