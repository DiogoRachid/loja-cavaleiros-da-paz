{
  "name": "SpotifyToken",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string",
      "description": "Access token atual do Spotify"
    },
    "refresh_token": {
      "type": "string",
      "description": "Refresh token para renovar o acesso"
    },
    "expires_at": {
      "type": "number",
      "description": "Timestamp (ms) de quando o access_token expira"
    }
  },
  "required": [
    "access_token",
    "refresh_token"
  ]
}