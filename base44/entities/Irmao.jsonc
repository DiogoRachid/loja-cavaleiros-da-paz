{
  "name": "Irmao",
  "type": "object",
  "properties": {
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do irm\u00e3o"
    },
    "numero_glp": {
      "type": "string",
      "description": "N\u00famero de cadastro na GLP (usado como login e senha inicial)"
    },
    "senha": {
      "type": "string",
      "description": "Senha de acesso (padr\u00e3o: n\u00famero GLP)"
    },
    "primeiro_acesso": {
      "type": "boolean",
      "default": true,
      "description": "Se \u00e9 o primeiro acesso (deve trocar senha)"
    },
    "email": {
      "type": "string",
      "description": "Email do irm\u00e3o"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "grau": {
      "type": "string",
      "enum": [
        "Aprendiz",
        "Companheiro",
        "Mestre"
      ],
      "description": "Grau ma\u00e7\u00f4nico"
    },
    "cargo": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Vener\u00e1vel Mestre",
        "Primeiro Vigilante",
        "Segundo Vigilante",
        "Orador",
        "Secret\u00e1rio",
        "Secret\u00e1rio de A\u00e7\u00e3o Social",
        "Tesoureiro",
        "Chanceler",
        "Bibliotec\u00e1rio",
        "Mestre de Cerim\u00f4nias",
        "Mestre de Harmonia",
        "Primeiro Di\u00e1cono",
        "Segundo Di\u00e1cono",
        "Porta Bandeira",
        "Porta Espada",
        "Arquiteto",
        "Hospitaleiro",
        "M\u00fasico",
        "Cobrador",
        "Guarda Interno",
        "Guarda Externo",
        "Primeiro Experto",
        "Segundo Experto",
        "Mestre de Banquetes"
      ],
      "default": "Nenhum",
      "description": "Cargo na loja"
    },
    "data_iniciacao": {
      "type": "string",
      "format": "date",
      "description": "Data de inicia\u00e7\u00e3o na loja"
    },
    "data_elevacao": {
      "type": "string",
      "format": "date",
      "description": "Data de eleva\u00e7\u00e3o ao grau de Companheiro"
    },
    "data_exaltacao": {
      "type": "string",
      "format": "date",
      "description": "Data de exalta\u00e7\u00e3o ao grau de Mestre"
    },
    "situacao": {
      "type": "string",
      "enum": [
        "Regular",
        "Irregular",
        "Suspenso",
        "Afastado"
      ],
      "default": "Regular",
      "description": "Situa\u00e7\u00e3o na loja"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o irm\u00e3o est\u00e1 ativo na loja"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do irm\u00e3o"
    },
    "profissao": {
      "type": "string",
      "description": "Profiss\u00e3o do irm\u00e3o"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "nome_completo",
    "numero_glp"
  ]
}