{
  "name": "Emprestimo",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "ID do item emprestado"
    },
    "item_nome": {
      "type": "string",
      "description": "Nome do item (para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "irmao_id": {
      "type": "string",
      "description": "ID do irm\u00e3o que fez o empr\u00e9stimo"
    },
    "irmao_nome": {
      "type": "string",
      "description": "Nome do irm\u00e3o (para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "irmao_email": {
      "type": "string",
      "description": "Email do irm\u00e3o"
    },
    "data_retirada": {
      "type": "string",
      "format": "date",
      "description": "Data da retirada"
    },
    "data_prevista_devolucao": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para devolu\u00e7\u00e3o"
    },
    "data_devolucao": {
      "type": "string",
      "format": "date",
      "description": "Data real da devolu\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Devolvido",
        "Atrasado"
      ],
      "default": "Ativo",
      "description": "Status do empr\u00e9stimo"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "QR Code",
        "Manual"
      ],
      "description": "Como foi feita a opera\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do empr\u00e9stimo"
    }
  },
  "required": [
    "item_id",
    "irmao_id",
    "data_retirada",
    "status"
  ]
}