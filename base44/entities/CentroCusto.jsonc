  "name": "CentroCusto",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do centro de custo (ex: Bebidas, Marmitas)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do centro de custo"
    },
