{
  "name": "Sessao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero da sess\u00e3o"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da sess\u00e3o"
    },
    "hora": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio (ex: 19:30)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Ordin\u00e1ria",
        "Extraordin\u00e1ria",
        "Magna",
        "P\u00fablica",
        "De Instru\u00e7\u00e3o",
        "F\u00fanebre"
      ],
      "description": "Tipo da sess\u00e3o"
    },
    "grau": {
      "type": "string",
      "enum": [
        "Aprendiz",
        "Companheiro",
        "Mestre"
      ],
      "default": "Aprendiz",
      "description": "Grau m\u00ednimo para participa\u00e7\u00e3o"
    },
    "pauta": {
      "type": "string",
      "description": "Pauta da sess\u00e3o"
    },
    "ata": {
      "type": "string",
      "description": "Ata da sess\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Agendada",
        "Realizada",
        "Cancelada"
      ],
      "default": "Agendada",
      "description": "Status da sess\u00e3o"
    },
    "local": {
      "type": "string",
      "description": "Local da sess\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "preparacao_json": {
      "type": "string",
      "description": "Dados salvos da prepara\u00e7\u00e3o da reuni\u00e3o (JSON)"
    }
  },
  "required": [
    "data",
    "hora",
    "tipo",
    "status"
  ]
}