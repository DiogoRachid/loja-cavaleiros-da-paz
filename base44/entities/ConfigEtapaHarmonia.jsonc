{
  "name": "ConfigEtapaHarmonia",
  "type": "object",
  "properties": {
    "grau": {
      "type": "string",
      "enum": [
        "Aprendiz",
        "Companheiro",
        "Mestre"
      ],
      "description": "Grau da sess\u00e3o para o qual esta configura\u00e7\u00e3o se aplica"
    },
    "tipo_sessao": {
      "type": "string",
      "enum": [
        "Ordin\u00e1ria",
        "Magna",
        "P\u00fablica",
        "Instru\u00e7\u00e3o",
        "F\u00fanebre"
      ],
      "description": "Tipo da sess\u00e3o para o qual esta configura\u00e7\u00e3o se aplica"
    },
    "etapa_nome": {
      "type": "string",
      "description": "Nome da etapa do roteiro (ex: Entrada, Abertura)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o da etapa"
    },
    "playlist_id": {
      "type": "string",
      "description": "ID da playlist Spotify vinculada por padr\u00e3o a esta etapa"
    },
    "playlist_name": {
      "type": "string",
      "description": "Nome da playlist vinculada"
    }
  },
  "required": [
    "grau",
    "tipo_sessao",
    "etapa_nome"
  ]
}