{
  "name": "MinhaPlaylist",
  "type": "object",
  "properties": {
    "spotify_playlist_id": {
      "type": "string",
      "description": "ID da playlist no Spotify"
    },
    "spotify_playlist_name": {
      "type": "string",
      "description": "Nome da playlist"
    },
    "spotify_playlist_image": {
      "type": "string",
      "description": "URL da imagem da playlist"
    },
    "spotify_playlist_uri": {
      "type": "string",
      "description": "URI da playlist no Spotify"
    },
    "owner": {
      "type": "string",
      "description": "Dono da playlist"
    },
    "tracks_total": {
      "type": "number",
      "description": "Total de m\u00fasicas na playlist"
    }
  },
  "required": [
    "spotify_playlist_id",
    "spotify_playlist_name"
  ]
}