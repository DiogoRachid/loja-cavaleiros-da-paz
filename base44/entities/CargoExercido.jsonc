{
  "name": "CargoExercido",
  "type": "object",
  "properties": {
    "irmao_id": {
      "type": "string",
      "description": "ID do irm\u00e3o"
    },
    "irmao_nome": {
      "type": "string",
      "description": "Nome do irm\u00e3o"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo exercido"
    },
    "exercicio": {
      "type": "string",
      "description": "Exerc\u00edcio (ano ou per\u00edodo)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio no cargo"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim no cargo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da movimenta\u00e7\u00e3o"
    }
  },
  "required": [
