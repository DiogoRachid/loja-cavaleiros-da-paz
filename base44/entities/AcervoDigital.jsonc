{
  "name": "AcervoDigital",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do documento"
    },
    "autor": {
      "type": "string",
      "description": "Autor do documento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Livro",
        "Trabalho",
        "Artigo",
        "Instru\u00e7\u00e3o",
        "Ritual",
        "Outro"
      ],
      "description": "Tipo do documento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou resumo do documento"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date",
      "description": "Data de publica\u00e7\u00e3o ou elabora\u00e7\u00e3o da obra"
    },
    "grau_minimo": {
      "type": "string",
      "enum": [
        "Aprendiz",
        "Companheiro",
        "Mestre"
      ],
      "default": "Aprendiz",
      "description": "Grau m\u00ednimo para acesso"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo PDF"
    },
    "capa_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o documento est\u00e1 ativo"
    },
    "disponivel": {
      "type": "boolean",
      "default": true,
      "description": "Se o documento est\u00e1 dispon\u00edvel para os irm\u00e3os acessarem"
    }
  },
  "required": [
    "titulo",
    "tipo",
    "arquivo_url"
  ]
}