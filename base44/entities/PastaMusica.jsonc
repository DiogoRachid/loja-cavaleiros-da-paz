{
  "name": "PastaMusica",
  "type": "object",
  "properties": {
    "pasta_id": {
      "type": "string",
      "description": "ID da pasta (playlist)"
    },
    "mp3_id": {
      "type": "string",
      "description": "ID da m\u00fasica na biblioteca (MinhaMp3)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de reprodu\u00e7\u00e3o dentro da pasta"
    }
  },
  "required": [
    "pasta_id",
    "mp3_id"
  ]
}