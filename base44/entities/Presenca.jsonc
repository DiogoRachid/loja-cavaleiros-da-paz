{
  "name": "Presenca",
  "type": "object",
  "properties": {
    "sessao_id": {
      "type": "string",
      "description": "ID da sess\u00e3o"
    },
    "sessao_data": {
      "type": "string",
      "description": "Data da sess\u00e3o (para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "irmao_id": {
      "type": "string",
      "description": "ID do irm\u00e3o"
    },
    "irmao_nome": {
      "type": "string",
      "description": "Nome do irm\u00e3o"
    },
    "irmao_cim": {
      "type": "string",
      "description": "CIM do irm\u00e3o"
    },
    "presente": {
      "type": "boolean",
      "default": false,
      "description": "Se o irm\u00e3o esteve presente"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da aus\u00eancia"
    },
    "justificativa_aceita": {
      "type": "boolean",
      "default": false,
      "description": "Se a justificativa foi aceita pelo secret\u00e1rio"
    }
  },
  "required": [
    "sessao_id",
    "irmao_id"
  ]
}