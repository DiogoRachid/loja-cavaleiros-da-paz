{
  "name": "Comissao",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da comiss\u00e3o"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Permanente",
        "Especial",
        "Tempor\u00e1ria"
      ],
      "default": "Permanente",
      "description": "Tipo da comiss\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o e objetivos da comiss\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a comiss\u00e3o est\u00e1 ativa"
    },
    "data_criacao": {
      "type": "string",
      "format": "date",
      "description": "Data de cria\u00e7\u00e3o da comiss\u00e3o"
    },
    "exercicio": {
      "type": "string",
      "description": "Exerc\u00edcio (ano) da comiss\u00e3o"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}