      "type": "string",
      "description": "Nome da loja"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero da loja"
    },
    "potencia": {
      "type": "string",
      "description": "Pot\u00eancia ma\u00e7\u00f4nica"
    },
    "oriente": {
      "type": "string",
      "description": "Cidade/Oriente da loja"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o do Templo"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone da loja"
    },
    "email": {
      "type": "string",
      "description": "Email institucional"
    },
